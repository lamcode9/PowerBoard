{
  "name": "@powerboard/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/rasterizeWorker.mjs','dist/rasterizeWorker.mjs')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcp": "tsx src/mcp.ts",
    "mcp:check": "tsx src/mcpCheck.ts",
    "cloud:safety": "tsx src/cloudSafety.ts",
    "sync:cloud": "tsx src/syncCloud.ts",
    "import:cloud": "tsx src/importCloud.ts",
    "soak": "tsx src/mcpSoak.ts"
  },
  "dependencies": {
    "@powerboard/renderers": "file:../../packages/renderers",
    "@powerboard/schema": "file:../../packages/schema",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "ws": "^8.18.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
